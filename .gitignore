# Animation frames and source videos are distributed as a GitHub Release asset
# to keep the repository small; they are placed back by scripts/fetch_renderer.py.
# Keep the base portrait and icon (used by both renderers) in the repository.
godot/assets/yayan-*
!godot/assets/yayan-watercolor-base.png
assets/yayan-*
!assets/yayan-icon.svg
!assets/yayan-watercolor-base.png
assets/*.mp4

# Asset QC / review pages (local working artifacts)
assets/_*.html

# Godot import stubs (regenerated when the project is opened)
*.import

# Export leftovers
*.TMP
